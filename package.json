{
  "name": "react-tree-checkbox",
  "version": "1.4.1",
  "description": "A lightweight but complete react tree with checkbox functionality",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.esm.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arslanahmed777/react-tree-checkbox"
  },
  "homepage": "https://arslanahmed777.github.io/react-tree-checkbox",
  "scripts": {
    "build": "webpack && node ./scripts/postBuildInterop.cjs",
    "test": "npm run verify:interop",
    "verify:interop": "npm run build && node ./scripts/verifyInterop.mjs",
    "docs:dev": "npm run build && vite --config website/vite.config.js",
    "docs:build": "npm run build && vite build --config website/vite.config.js",
    "docs:preview": "vite preview --config website/vite.config.js",
    "docs:deploy": "npm run docs:build && gh-pages -d website/dist"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.7.5",
    "@babel/preset-env": "^7.7.6",
    "@babel/preset-react": "^7.7.4",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-loader": "^8.0.6",
    "css-loader": "^6.5.1",
    "gh-pages": "^6.3.0",
    "prop-types": "^15.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass-loader": "^10.1.1",
    "style-loader": "^3.3.1",
    "svg-url-loader": "^7.1.1",
    "vite": "^8.1.5",
    "webpack": "^5.65.0",
    "webpack-cli": "^4.9.1"
  },
  "keywords": [
    "react-tree-checkbox",
    "react-checkbox-tree",
    "tree-nav",
    "tree",
    "react",
    "tree-navigation",
    "treeview",
    "treeNav"
  ],
  "author": "Arslan Ahmed Shaad",
  "license": "ISC"
}
